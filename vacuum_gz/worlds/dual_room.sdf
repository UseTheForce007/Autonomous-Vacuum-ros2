<?xml version="1.0" ?>
<sdf version="1.10">

<world name="two_rooms">

  <!-- ===================== -->
  <!-- PHYSICS + SYSTEMS     -->
  <!-- ===================== -->

  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>

  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>

  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>

  <!-- ===================== -->
  <!-- LIGHTING (IMPORTANT)  -->
  <!-- ===================== -->

  <scene>
    <ambient>0.85 0.85 0.85 1</ambient>
    <background>0.75 0.75 0.75 1</background>
  </scene>

  <light name="sun" type="directional">
    <pose>0 0 10 0 0 0</pose>
    <direction>-0.5 0.2 -1</direction>

    <diffuse>1 1 1 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <cast_shadows>true</cast_shadows>
  </light>

  <!-- ===================== -->
  <!-- GROUND PLANE          -->
  <!-- ===================== -->

  <!-- Ground plane with collision and visual -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>14 8 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>14 8 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ===================== -->
  <!-- OUTER WALLS           -->
  <!-- ===================== -->

  <model name="outer_walls">
    <static>true</static>

    <!-- South -->
    <link name="south">
      <pose>0 -4 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>14 0.1 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>14 0.1 1</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- North -->
    <link name="north">
      <pose>0 4 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>14 0.1 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>14 0.1 1</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- West -->
    <link name="west">
      <pose>-7 0 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>0.1 8 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>0.1 8 1</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- East -->
    <link name="east">
      <pose>7 0 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>0.1 8 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>0.1 8 1</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Divider left (with doorway gap in center) -->
    <link name="divider_left">
      <pose>0 -2.2 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>0.1 3.2 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>0.1 3.2 1</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="divider_right">
      <pose>0 2.2 0.5 0 0 0</pose>

      <collision name="c">
        <geometry><box><size>0.1 3.2 1</size></box></geometry>
      </collision>

      <visual name="v">
        <geometry><box><size>0.1 3.2 1</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

  </model>

  <!-- ===================== -->
  <!-- OBSTACLES ROOM 1      -->
  <!-- ===================== -->

  <model name="table">
    <static>true</static>
    <pose>-3 1 0.3 0 0 0</pose>

    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.3 0.2 1</ambient>
          <diffuse>0.7 0.3 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="box">
    <static>true</static>
    <pose>-1.5 -1.5 0.25 0 0 0</pose>

    <link name="link">
      <collision name="collision"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.8 0.8 0.5</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ===================== -->
  <!-- OBSTACLES ROOM 2      -->
  <!-- ===================== -->

  <model name="sofa">
    <static>true</static>
    <pose>4 1.5 0.35 0 0 0</pose>

    <link name="link">
      <collision name="collision"><geometry><box><size>2 0.8 0.7</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2 0.8 0.7</size></box></geometry>
        <material>
          <ambient>0.2 0.7 0.3 1</ambient>
          <diffuse>0.2 0.7 0.3 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <model name="chair">
    <static>true</static>
    <pose>3 -2 0.3 0 0 0</pose>

    <link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.8 0.2 1</ambient>
          <diffuse>0.8 0.8 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

</world>

</sdf>
